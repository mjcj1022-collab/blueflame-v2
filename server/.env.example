# Copy to .env and fill in. Nothing here is committed.

# Postgres connection string (Neon, Supabase, RDS, Railway, or local)
DATABASE_URL=postgres://user:password@host:5432/mandrel

# Stripe — from dashboard.stripe.com/apikeys (use test keys first)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price ids from Stripe → Products (to sell access to the studio)
STRIPE_PRICE_MONTHLY=price_...   # the $40/mo recurring price
STRIPE_PRICE_OFFLINE=price_...   # the $450 one-time price

# JWT signing secret — generate a long random string
JWT_SECRET=change-me-to-a-64-char-random-string

# Where the client is served (for CORS)
CLIENT_ORIGIN=https://mjcj1022-collab.github.io

# Comma-separated emails that get free full access with no Stripe subscription
# at all — use this for your own account so you're never paywalled.
COMP_EMAILS=mike

# Resend — resend.com/api-keys. Used to send the "your offline download is
# ready" email right after a $450 one-time purchase clears. Leave unset and
# the app still works, it just logs the email instead of sending it.
RESEND_API_KEY=re_...
# Must be "Name <email@domain>" on a domain verified in Resend. Until you
# verify a domain, Resend's shared address only delivers to your own Resend
# account email, so real customers won't get mail — verify a domain first.
EMAIL_FROM=Mandrel <hello@yourdomain.com>
# The hosted site's URL — used to build the "sign in & download" link in
# that email.
SITE_URL=https://mjcj1022-collab.github.io/blueflame-v2/

# Optional — path to the offline .zip served by GET /api/offline-download.
# Defaults to server/offline-dist/Mandrel-Offline.zip, falling back to
# BlueFlame-Offline.zip in the same folder if that's what's already published
# (see the README in that folder for how to publish it); only set this if
# you're serving the file from somewhere else.
# OFFLINE_ZIP_PATH=/absolute/path/to/Mandrel-Offline.zip

PORT=8787
